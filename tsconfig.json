{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmitOnError": true, "rootDir": "src", "outDir": "site/assets",
    "removeComments": false, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
